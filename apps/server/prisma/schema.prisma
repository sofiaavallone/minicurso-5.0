generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        String   @id @default(cuid())
    email     String   @unique
    name      String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum LetterCategory {
    memoria
    sonho
    conselho
}

model Letter {
    id         String         @id @default(cuid())
    authorName String?
    title      String
    category   LetterCategory
    content    String         @db.Text
    deliverAt  DateTime
    createdAt  DateTime       @default(now())
    updatedAt  DateTime       @updatedAt

    @@index([deliverAt])
}
